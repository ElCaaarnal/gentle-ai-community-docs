---
import BaseLayout from '../layouts/BaseLayout.astro';
import InterfaceChrome from '../components/InterfaceChrome.astro';
import Sidebar from '../components/Sidebar.astro';
import DocumentationContent from '../components/DocumentationContent.astro';
---

<BaseLayout
  title="Documentación de Gentle AI"
  description="Documentación en español de Gentle AI: instalación, agentes soportados, Engram, SDD, OpenSpec, Strict TDD, skills y revisión acotada (RDD)."
>
  <InterfaceChrome />
  <div class="wrap">
    <Sidebar />
    <main id="contenido" tabindex="-1">
      <DocumentationContent />
    </main>
  </div>
  <script src="../scripts/site.js"></script>
</BaseLayout>
