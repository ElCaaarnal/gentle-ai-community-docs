---
import { site, type Locale } from '../i18n/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentationContent from './DocumentationContent.astro';
import InterfaceChrome from './InterfaceChrome.astro';
import Sidebar from './Sidebar.astro';
const { locale } = Astro.props as { locale: Locale };
const copy = site[locale];
---

<BaseLayout title={copy.title} description={copy.description} lang={copy.lang}>
  <InterfaceChrome copy={copy} />
  <div class="wrap">
    <Sidebar copy={copy} />
    <main id="contenido" tabindex="-1">
      <DocumentationContent />
    </main>
  </div>
  <script src="../scripts/site.js"></script>
</BaseLayout>
