---
import type { SiteCopy } from '../i18n/site';

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<header id="topbar">
  <button id="menuBtn" aria-label={copy.menu}>☰</button>
  <span class="tb-brand">Gentle<span>-AI</span></span>
  <button id="searchBtnM" aria-label={copy.search}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
  </button>
</header>
<div id="scrim"></div>
<button id="toTop" aria-label={copy.backToTop}>↑</button>
<div id="searchOverlay" role="dialog" aria-modal="true" aria-label={copy.searchDocumentation}>
  <div class="searchbox">
    <input id="searchInput" type="text" autocomplete="off" spellcheck="false" aria-label={copy.searchDocumentation} placeholder={copy.searchPlaceholder} />
    <div id="searchResults" role="listbox" aria-label={copy.searchResults}></div>
    <div class="searchfoot">
      <span><kbd>↑</kbd><kbd>↓</kbd> {copy.searchNavigate}</span>
      <span><kbd>↵</kbd> {copy.searchOpen}</span>
      <span><kbd>esc</kbd> {copy.searchClose}</span>
    </div>
  </div>
</div>
<a href="#contenido" class="skip">{copy.skipToContent}</a>
