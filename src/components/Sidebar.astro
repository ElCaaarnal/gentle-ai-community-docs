---
import type { SiteCopy } from '../i18n/site';

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const isEnglish = copy.lang === 'en';
---

<aside>
  <p class="brand">Gentle<span>-AI</span></p>
  <p class="tag">{copy.tagline}</p>
  <button class="searchbtn" id="searchBtn" aria-label={copy.searchDocumentation}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    {copy.search}
    <span class="kbd"><kbd>/</kbd></span>
  </button>
  <nav id="nav" aria-label={copy.navigation}>
    {copy.navigationGroups.map(([label, links]) => (
      <>
        <div class="grp">{label}</div>
        {links.map(([id, linkLabel]) => <a href={`#${id}`}>{linkLabel}</a>)}
      </>
    ))}
  </nav>
  <nav aria-label={copy.language}>
    <a href="/" hreflang="en" lang="en" aria-current={isEnglish ? 'page' : undefined}>English</a>
    <a href="/es/" hreflang="es" lang="es" aria-current={!isEnglish ? 'page' : undefined}>Español</a>
  </nav>
</aside>
